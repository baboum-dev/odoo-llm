<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_llm_provider_form_openrouter" model="ir.ui.view">
        <field name="name">llm.provider.form.openrouter</field>
        <field name="model">llm.provider</field>
        <field name="inherit_id" ref="base_llm.view_llm_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_sync_openrouter_models"
                        type="object"
                        string="Sync OpenRouter Models"
                        class="oe_highlight"
                        invisible="provider_type != 'openrouter'"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>